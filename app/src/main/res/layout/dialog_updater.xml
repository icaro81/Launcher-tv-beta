<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="440dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_silvo_dialog"
    android:padding="24dp">

    <TextView
        android:id="@+id/updaterTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/updater_title"
        android:textColor="@color/silvo_cyan_neon"
        android:textSize="20sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/updaterStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/updater_checking"
        android:textColor="@color/silvo_text_secondary"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <ProgressBar
        android:id="@+id/updaterProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:indeterminate="true"
        android:progressTint="@color/silvo_cyan_neon"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/updaterRepoInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/silvo_text_tertiary"
        android:textSize="12sp"
        android:layout_marginBottom="20dp"
        tools:text="GitHub: icaro81/Launcher-tv-beta" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancelUpdater"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@android:string/cancel"
            android:textColor="@color/silvo_text_secondary"
            android:background="@drawable/selector_app_card"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textAllCaps="false"
            android:focusable="true" />

        <Button
            android:id="@+id/btnActionUpdater"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:text="@string/action_check_updates"
            android:textColor="@color/silvo_cyan_neon"
            android:background="@drawable/selector_app_card"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textAllCaps="false"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>
