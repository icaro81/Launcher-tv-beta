<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="420dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_glass_3d_dialog"
    android:padding="28dp">

    <TextView
        android:id="@+id/voiceDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/action_voice_search"
        android:textColor="@color/silvo_cyan_neon"
        android:textSize="20sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="20dp" />

    <!-- Animated Microphone Pulse Ring -->
    <FrameLayout
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_marginBottom="20dp">

        <View
            android:id="@+id/voicePulseRing"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_icon_button_focused"
            android:alpha="0.45" />

        <ImageView
            android:id="@+id/voiceMicIcon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_mic_tv"
            android:contentDescription="@string/action_voice_search" />
    </FrameLayout>

    <TextView
        android:id="@+id/voiceStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/voice_listening"
        android:textColor="@color/silvo_text_primary"
        android:textSize="16sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/voiceTranscriptText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="28dp"
        android:gravity="center"
        android:textColor="@color/silvo_cyan_neon"
        android:textSize="15sp"
        android:fontFamily="sans-serif"
        android:layout_marginBottom="20dp"
        tools:text="“YouTube”" />

    <Button
        android:id="@+id/btnCancelVoice"
        android:layout_width="180dp"
        android:layout_height="44dp"
        android:text="@android:string/cancel"
        android:textColor="@color/silvo_text_secondary"
        android:background="@drawable/selector_app_card"
        android:textAllCaps="false"
        android:focusable="true" />

</LinearLayout>
